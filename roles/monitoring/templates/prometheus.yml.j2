# roles/monitoring/templates/prometheus.yml.j2
global:
  scrape_interval: 1m # How often to fetch metrics

{% set monitored_api_post_targets = monitored_apis_post | default([]) %}
{% if monitored_api_post_targets is not sequence or monitored_api_post_targets is string %}
{% set monitored_api_post_targets = [] %}
{% endif %}
{% set monitored_api_post_targets = monitored_api_post_targets | unique | list %}
{% set monitored_api_get_targets = monitored_apis | default([]) %}
{% if monitored_api_get_targets is not sequence or monitored_api_get_targets is string %}
{% set monitored_api_get_targets = [] %}
{% endif %}
{% set monitored_api_get_targets = monitored_api_get_targets | reject('in', monitored_api_post_targets) | unique | list %}

scrape_configs:
  # 1. Hardware metrics from your server
  - job_name: 'node-exporter'
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host].ansible_host }}:9100']
        labels:
          alias: '{{ host }}'
{% endfor %}

  # 2. Website monitoring (status codes, SSL, etc.)
  - job_name: 'website-monitoring'
    metrics_path: /probe
{% if monitored_sites | default([]) %}
    static_configs:
      - targets:
{% for site in monitored_sites %}
          - '{{ site }}'
{% endfor %}
        labels:
          service_type: website
          probe_method: GET
          auth_required: "false"
{% endif %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_module
        replacement: http_2xx
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115 # Address of the blackbox exporter

  # 3. API monitoring using the public HTTP 2xx probe.
  - job_name: 'api-monitoring'
    metrics_path: /probe
{% if monitored_api_get_targets %}
    static_configs:
      - targets:
{% for api in monitored_api_get_targets %}
          - '{{ api }}'
{% endfor %}
        labels:
          service_type: api
          probe_method: GET
          auth_required: "false"
{% endif %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_module
        replacement: http_2xx
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # API endpoint that accepts POST requests with a JSON body.
{% if monitored_api_post_targets %}
  - job_name: 'api-post-monitoring'
    metrics_path: /probe
    static_configs:
      - targets:
{% for api in monitored_api_post_targets %}
          - '{{ api }}'
{% endfor %}
        labels:
          service_type: api
          probe_method: POST
          auth_required: "false"
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_module
        replacement: http_api_post_check
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115
{% endif %}

  # Protected API endpoint; HTTP 401 is an expected response.
  - job_name: 'api-authenticated-monitoring'
    metrics_path: /probe
{% if monitored_apis_auth | default([]) %}
    static_configs:
      - targets:
{% for api in monitored_apis_auth %}
          - '{{ api }}'
{% endfor %}
        labels:
          service_type: api
          probe_method: GET
          auth_required: "true"
{% endif %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_module
        replacement: http_api_check
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter:9115

  # 4. VictoriaMetrics self-monitoring
  - job_name: 'victoria-metrics'
    static_configs:
      - targets: ['victoriametrics:8428'] 

# 4. MariaDB monitoring
{% for host in groups['all'] if hostvars[host].has_mysql | default(false) %}
{% if loop.first %}
  - job_name: 'mysql'
    static_configs:
{% endif %}
      - targets: ['{{ hostvars[host].ansible_host }}:9104']
        labels:
          alias: '{{ host }}'
          project: 'galera-cluster'
          desc: 'Galera Cluster'
{% endfor %}

  # 5. Docker monitoring
  - job_name: 'cadvisor'
    static_configs:
{% for host in groups['all'] if hostvars[host].is_swarm_manager | default(false) %}
      - targets: ['{{ hostvars[host].ansible_host }}:8080']
        labels:
          alias: '{{ host }}'
{% endfor %}

# 6. Kubernetes State Monitoring (ActiveCollab k8s & Aragorn k3s)
{% for host in groups['all'] if hostvars[host].has_k8s | default(false) or hostvars[host].has_k3s | default(false) %}
{% if loop.first %}
  - job_name: 'kubernetes-state'
    static_configs:
{% endif %}
      - targets: ['{{ hostvars[host].ansible_host }}:31080']
        labels:
          alias: '{{ host }}'
{% endfor %}

  # 7. ArgoCD Metrics (Aragorn only)
{% for host in groups['all'] if hostvars[host].has_argocd | default(false) %}
{% if loop.first %}
  - job_name: 'argocd-metrics'
    static_configs:
{% endif %}
      - targets: 
        - '{{ hostvars[host].ansible_host }}:31082' # Application Controller
        - '{{ hostvars[host].ansible_host }}:31083' # Repo Server
        labels:
          alias: '{{ host }}'
{% endfor %}

# 8. ElasticSearch monitoring
{% for host in groups['all'] if hostvars[host].has_elasticsearch | default(false) %}
{% if loop.first %}
  - job_name: 'elasticsearch'
    static_configs:
{% endif %}
      - targets: ['{{ hostvars[host].ansible_host }}:9114']
        labels:
          alias: '{{ host }}'
          project: 't-800'
{% endfor %}

