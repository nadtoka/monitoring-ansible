# roles/monitoring/templates/yace.yml.j2
apiVersion: v1alpha1
static:
  - namespace: AWS/RDS
    name: rds-mariadb
    regions:
      - {{ aws_rds_region | default('us-east-1') }}
    dimensions:
      - name: DBInstanceIdentifier
        value: {{ aws_rds_instance_identifier | default('production-databases') }}
    metrics:
      - name: DatabaseConnections
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: CPUUtilization
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: FreeableMemory
        statistics: [Average, Minimum]
        period: 300
        length: 300
      - name: FreeStorageSpace
        statistics: [Average, Minimum]
        period: 300
        length: 300
      - name: ReadIOPS
        statistics: [Average]
        period: 300
        length: 300
      - name: WriteIOPS
        statistics: [Average]
        period: 300
        length: 300
      - name: ReadLatency
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: WriteLatency
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: SwapUsage
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: DiskQueueDepth
        statistics: [Average, Maximum]
        period: 300
        length: 300
      - name: NetworkReceiveThroughput
        statistics: [Average]
        period: 300
        length: 300
      - name: NetworkTransmitThroughput
        statistics: [Average]
        period: 300
        length: 300
      - name: BinLogDiskUsage
        statistics: [Average]
        period: 300
        length: 300
