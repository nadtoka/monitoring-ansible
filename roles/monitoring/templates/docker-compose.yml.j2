# roles/monitoring/templates/docker-compose.yml.j2

services:
  victoriametrics:
    image: victoriametrics/victoria-metrics:{{ victoriametrics_version }}
    container_name: victoriametrics
    ports:
      - "{{ victoriametrics_port }}:8428"
    volumes:
      - vmdata:/storage
      - ./prometheus.yml:/etc/prometheus/prometheus.yml:ro
    command:
      - "--storageDataPath=/storage"
      - "--retentionPeriod=1y"
      - "--promscrape.config=/etc/prometheus/prometheus.yml"
      - "-vmalert.proxyURL=http://vmalert:8880"
    restart: always

  blackbox-exporter:
    image: prom/blackbox-exporter:latest
    container_name: blackbox-exporter
    ports:
      - "9115:9115"
    dns:
      - 1.1.1.1
      - 8.8.8.8
      - 192.168.50.1
    volumes:
      - ./blackbox.yml:/etc/blackbox_exporter/config.yml:ro
    command:
      - "--config.file=/etc/blackbox_exporter/config.yml"
    restart: always

  vmalert:
    container_name: vmalert
    image: victoriametrics/vmalert:v1.101.0
    depends_on:
      - victoriametrics
    ports:
      - "8880:8880"
    volumes:
      - ./vmalert/rules.yml:/etc/alerts/rules.yml
    command:
      - "-datasource.url=http://victoriametrics:8428"
      - "-notifier.url=http://alertmanager:9093"
      - "-rule=/etc/alerts/rules.yml"
      - "-httpListenAddr=0.0.0.0:8880"
      - "-http.disableResponseCompression"
    restart: always

  # Обробка та маршрутизація алертів
  alertmanager:
    container_name: alertmanager
    image: prom/alertmanager:v0.27.0
    depends_on:
      - alertmanager-gchat-relay
    ports:
      - "9093:9093"
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
    restart: always

  alertmanager-gchat-relay:
    image: python:3.12-alpine
    environment:
      GCHAT_WEBHOOK_URL: "{{ google_chat_webhook_url }}"
    volumes:
      - ./gchat_relay.py:/app/gchat_relay.py:ro
    command: ["python3", "-u", "/app/gchat_relay.py"]
    restart: unless-stopped

  grafana:
    image: grafana/grafana:{{ grafana_version }}
    container_name: grafana
    ports:
      - "{{ grafana_port }}:3000"
    environment:
      - GF_SECURITY_ADMIN_PASSWORD={{ grafana_admin_password }}
    volumes:
      - grafanadata:/var/lib/grafana
      - ./grafana/provisioning/dashboards/dashboard.yml:/etc/grafana/provisioning/dashboards/dashboard.yml:ro
      - ./grafana/provisioning/datasources/datasource.yml:/etc/grafana/provisioning/datasources/datasource.yml:ro
      - ./grafana/dashboards:/var/lib/grafana/dashboards:ro
    depends_on:
      - victoriametrics
    restart: always

{% if vault_aws_yace_access_key is defined and vault_aws_yace_secret_key is defined %}
  yace:
    image: quay.io/prometheuscommunity/yet-another-cloudwatch-exporter:{{ yace_version | default('v0.68.0') }}
    container_name: yace
    ports:
      - "5000:5000"
    environment:
      AWS_ACCESS_KEY_ID: "{{ vault_aws_yace_access_key }}"
      AWS_SECRET_ACCESS_KEY: "{{ vault_aws_yace_secret_key }}"
      AWS_REGION: "{{ aws_rds_region | default('us-east-1') }}"
    volumes:
      - ./yace.yml:/tmp/config.yml:ro
    command:
      - "--config.file=/tmp/config.yml"
      - "--listen-address=:5000"
      - "--disable-account-alias-lookup"
    restart: always
{% endif %}

volumes:
  vmdata:
  grafanadata:
