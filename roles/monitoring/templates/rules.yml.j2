groups:
  - name: HostStatus
    rules:
      - alert: HostDown
        expr: up{job="node-exporter"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Сервер {{ '{{' }} $labels.instance {{ '}}' }} ({{ '{{' }} $labels.alias {{ '}}' }}) недоступний"
          description: "Node Exporter не відповідає більше 5 хвилин."

      - alert: DiskSpaceLow
        expr: (node_filesystem_avail_bytes{mountpoint="/"} * 100) / node_filesystem_size_bytes{mountpoint="/"} < 15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Мало місця на диску на {{ '{{' }} $labels.alias {{ '}}' }}"
          description: "На розділі / залишилося менше 15% вільного місця (зараз: {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}%)."

      - alert: HostHighCpuLoad
        expr: 100 - (avg by(instance, alias) (rate(node_cpu_seconds_total{mode="idle"}[5m])) * 100) > 95
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Високе навантаження CPU на {{ '{{' }} $labels.alias {{ '}}' }}"
          description: "CPU завантажений на {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}% протягом останніх 15 хвилин."

  - name: NetworkAndTraffic
    rules:
      # Загальний поріг для всіх серверів (350 Mbit/s)
      - alert: HighNetworkTrafficIn
        expr: sum by(instance, alias) (rate(node_network_receive_bytes_total{device!~"^(lo|docker.*|veth.*|br-.*|virbr.*|tun.*|tap.*|cni.*|flannel.*|cali.*)$"}[5m])) > 43750000 and on(alias) (node_uname_info{alias!="AWS-Swarm-Node"})
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Високий вхідний трафік на {{ '{{' }} $labels.alias {{ '}}' }}"
          description: "Вхідний трафік на фізичних інтерфейсах перевищує 350 Mbit/s (зараз: {{ '{{' }} $value | humanize1024 {{ '}}' }}B/s)."

      # Окремий поріг для AWS-Swarm-Node (500 Mbit/s = 62.5 MB/s)
      - alert: HighNetworkTrafficInAWSSwarm
        expr: sum by(instance, alias) (rate(node_network_receive_bytes_total{device!~"^(lo|docker.*|veth.*|br-.*|virbr.*|tun.*|tap.*|cni.*|flannel.*|cali.*)$"}[5m])) > 62500000 and on(alias) (node_uname_info{alias="AWS-Swarm-Node"})
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Високий вхідний трафік на {{ '{{' }} $labels.alias {{ '}}' }}"
          description: "Вхідний трафік на AWS Swarm перевищує 500 Mbit/s (зараз: {{ '{{' }} $value | humanize1024 {{ '}}' }}B/s)."

      - alert: MemoryHighUsage
        expr: (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100 < 10
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Мало доступної пам'яті на {{ '{{' }} $labels.alias {{ '}}' }}"
          description: "Вільно менше 10% оперативної пам'яті (зараз: {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}%)."

  - name: BlackboxAlerts
    rules:
      - alert: WebsiteDown
        expr: probe_success{service_type="website"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Website is DOWN: {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "HTTP перевірка для {{ '{{' }} $labels.instance {{ '}}' }} повернула помилку."

      - alert: ApiDown
        expr: probe_success{service_type="api"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "API is DOWN: {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "API probe failed for {{ '{{' }} $labels.instance {{ '}}' }}."

      - alert: WebsiteSlowResponse
        expr: probe_duration_seconds{service_type="website"} > 5
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Website slow response: {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "Probe duration exceeded 5s (current: {{ '{{' }} $value | humanizeDuration {{ '}}' }}) for 5m."

      - alert: ApiSlowResponse
        expr: probe_duration_seconds{service_type="api"} > 3
        for: 4m
        labels:
          severity: warning
        annotations:
          summary: "API slow response: {{ '{{' }} $labels.instance {{ '}}' }}"
          description: "API probe duration exceeded 3s (current: {{ '{{' }} $value | humanizeDuration {{ '}}' }}) for 4m."

      - alert: SSLCertificateExpiringSoon
        expr: probe_ssl_earliest_certificate_expiry - time() < 86400 * 14
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Сертифікат сайту {{ '{{' }} $labels.instance {{ '}}' }} скоро закінчується"
          description: "До завершення дії сертифіката залишилося менше 14 днів."

  - name: MySQL_Galera
    rules:
      - alert: MySQLDown
        expr: mysql_up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "MySQL на {{ '{{' }} $labels.alias {{ '}}' }} впав"
          description: "Експортер не може підключитися до бази на ноді {{ '{{' }} $labels.instance {{ '}}' }}."

      - alert: GaleraClusterSizeAlert
        expr: mysql_global_status_wsrep_cluster_size < 3
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: "Проблема з кластером Галера!"
          description: "Розмір кластера зменшився до {{ '{{' }} $value {{ '}}' }}. Можлива втрата кворуму."

  - name: AWS_RDS
    rules:
      - alert: RDSHighConnectionsWarning
        expr: aws_rds_database_connections_maximum > 80
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Підвищена кількість підключень до RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})"
          description: "Кількість активних конекшенів перевищила 80 (зараз: {{ '{{' }} $value | printf \"%.0f\" {{ '}}' }})."

      - alert: RDSHighConnectionsCritical
        expr: aws_rds_database_connections_maximum > 120
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Критична кількість підключень до RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})!"
          description: "Кількість активних конекшенів перевищила 120 (зараз: {{ '{{' }} $value | printf \"%.0f\" {{ '}}' }}). Можливе вичерпання пулу підключень."

      - alert: RDSHighCPUWarning
        expr: aws_rds_cpuutilization_average > 85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Високе навантаження CPU на RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})"
          description: "CPU інстансу бази завантажений на {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}% протягом 10 хвилин."

      - alert: RDSHighCPUCritical
        expr: aws_rds_cpuutilization_average > 95
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Критичне навантаження CPU на RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})!"
          description: "CPU інстансу бази завантажений на {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}% протягом 5 хвилин. Загроза зависання бази."

      - alert: RDSLowStorageSpaceWarning
        expr: aws_rds_free_storage_space_minimum < 10737418240
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Закінчується вільне місце на диску RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})"
          description: "На диску RDS залишилося менше 10 ГБ вільного місця (зараз: {{ '{{' }} $value | humanize1024 {{ '}}' }}B)."

      - alert: RDSLowStorageSpaceCritical
        expr: aws_rds_free_storage_space_minimum < 5368709120
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Критично мало місця на диску RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})!"
          description: "На диску RDS залишилося менше 5 ГБ вільного місця (зараз: {{ '{{' }} $value | humanize1024 {{ '}}' }}B)."

      - alert: RDSLowFreeableMemory
        expr: aws_rds_freeable_memory_minimum < 524288000
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Мало вільної RAM на RDS ({{ '{{' }} $labels.dimension_DBInstanceIdentifier {{ '}}' }})"
          description: "Доступно менше 500 МБ оперативної пам'яті на RDS (зараз: {{ '{{' }} $value | humanize1024 {{ '}}' }}B)."

  - name: AWS_SES
    rules:
      - alert: SESHighBounceRateWarning
        expr: aws_ses_reputation_bounce_rate_average * 100 > 5
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Підвищений SES Bounce Rate ({{ '{{' }} $labels.region {{ '}}' }})"
          description: "Рівень відмов (Bounce Rate) перевищив 5% (зараз: {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}%). Рекомендується перевірити валідність бази отримувачів."

      - alert: SESHighBounceRateCritical
        expr: aws_ses_reputation_bounce_rate_average * 100 > 8
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Критичний SES Bounce Rate ({{ '{{' }} $labels.region {{ '}}' }})!"
          description: "Рівень відмов досяг {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}% (критичний поріг AWS: 10%). Загроза блокування відправки листів!"

      - alert: SESHighComplaintRateWarning
        expr: aws_ses_reputation_complaint_rate_average * 100 > 0.05
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Підвищений SES Complaint Rate ({{ '{{' }} $labels.region {{ '}}' }})"
          description: "Рівень скарг на спам перевищив 0.05% (зараз: {{ '{{' }} $value | printf \"%.3f\" {{ '}}' }}%)."

      - alert: SESHighComplaintRateCritical
        expr: aws_ses_reputation_complaint_rate_average * 100 > 0.08
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "Критичний SES Complaint Rate ({{ '{{' }} $labels.region {{ '}}' }})!"
          description: "Рівень скарг на спам досяг {{ '{{' }} $value | printf \"%.3f\" {{ '}}' }}% (максимум AWS: 0.1%). Терміново зупиніть масові розсилки!"

{% if vault_github_token is defined and vault_github_org is defined %}
  - name: GitHubRunners
    rules:
      - alert: GitHubRunnerOffline
        expr: github_runner_status == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "GitHub Actions Runner офлайн ({{ '{{' }} $labels.name {{ '}}' }})"
          description: "Раннер {{ '{{' }} $labels.name {{ '}}' }} (ID: {{ '{{' }} $labels.id {{ '}}' }}) знаходиться в статусі offline понад 5 хвилин."

      - alert: GitHubAPIRateLimitLow
        expr: github_ratelimit_remaining < 300
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: "Закінчується ліміт GitHub API ({{ '{{' }} $labels.org | default('foodtolive') {{ '}}' }})"
          description: "Залишилося менше 300 запитів до GitHub API (поточний залишок: {{ '{{' }} $value {{ '}}' }})."
{% endif %}

{% if vault_pbs_api_token is defined and pbs_monitoring_enabled | default(true) %}
  - name: ProxmoxBackupServer
    rules:
      - alert: PBSDown
        expr: pbs_up == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Proxmox Backup Server недоступний!"
          description: "pbs-exporter не може підключитися до API Proxmox Backup Server вже 3 хвилини."

      - alert: PBSDatastoreDiskSpaceWarning
        expr: (pbs_available / pbs_size) * 100 < 15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Мало місця на Datastore PBS ({{ '{{' }} $labels.datastore {{ '}}' }})"
          description: "На датасторі {{ '{{' }} $labels.datastore {{ '}}' }} залишилося менше 15% вільного місця."

      - alert: PBSDatastoreDiskSpaceCritical
        expr: (pbs_available / pbs_size) * 100 < 5
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "Критично мало місця на Datastore PBS ({{ '{{' }} $labels.datastore {{ '}}' }})!"
          description: "На датасторі {{ '{{' }} $labels.datastore {{ '}}' }} залишилося менше 5% місця! Загроза зупинки резервного копіювання!"

      - alert: PBSBackupFailed
        expr: pbs_snapshot_vm_last_verify == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "Помилка верифікації бекапу PBS ({{ '{{' }} $labels.vm_name {{ '}}' }})"
          description: "Останній бекап для VM {{ '{{' }} $labels.vm_name {{ '}}' }} (ID: {{ '{{' }} $labels.vm_id {{ '}}' }}) на датасторі {{ '{{' }} $labels.datastore {{ '}}' }} не пройшов верифікацію."
{% endif %}

{% if vault_pve_token_value is defined and vault_pve_host is defined and pve_monitoring_enabled | default(true) %}
  - name: ProxmoxVE
    rules:
      - alert: ProxmoxNodeDown
        expr: pve_node_online == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "Нода Proxmox VE офлайн ({{ '{{' }} $labels.node {{ '}}' }})!"
          description: "Нода Proxmox {{ '{{' }} $labels.node {{ '}}' }} не відповідає більше 3 хвилин."

      - alert: ProxmoxNodeHighCpuLoad
        expr: (pve_node_cpu_usage * 100) > 90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Високе навантаження CPU на ноді Proxmox ({{ '{{' }} $labels.node {{ '}}' }})"
          description: "Завантаження CPU ноди перевищує 90% (зараз: {{ '{{' }} $value | printf \"%.2f\" {{ '}}' }}%)."

      - alert: ProxmoxNodeMemoryLow
        expr: ((pve_node_memory_total_bytes - pve_node_memory_used_bytes) / pve_node_memory_total_bytes) * 100 < 10
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Закінчується оперативна пам'ять на ноді Proxmox ({{ '{{' }} $labels.node {{ '}}' }})"
          description: "Вільної пам'яті на ноді залишилося менше 10%."

      - alert: ProxmoxStorageSpaceLow
        expr: ((pve_storage_total_bytes - pve_storage_used_bytes) / pve_storage_total_bytes) * 100 < 15 and on(storage) (pve_storage_active == 1)
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "Мало місця на сховищі Proxmox ({{ '{{' }} $labels.storage {{ '}}' }})"
          description: "На сховищі {{ '{{' }} $labels.storage {{ '}}' }} на ноді {{ '{{' }} $labels.node {{ '}}' }} залишилося менше 15% вільного місця."
{% endif %}
